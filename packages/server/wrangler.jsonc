{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jinkei-gassen",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  // 送信元（IP）ごとの回数の上限。部屋の作成の連打と、4桁のコードの総当たりを抑える。
  // 拠点（Cloudflare の場所）ごとのおおよその数で、厳密ではない。namespace_id はこのアカウントの中で一意な整数
  "ratelimits": [
    { "name": "CREATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "JOIN_LIMITER", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } }
  ]
}
